create a basic Flask app -> {'success': True, 'files': [{'path': 'C:\\Users\\mark1\\OneDrive\\Desktop\\Coding Agent\\AI_Engineer\\app.py', 'content': 'import os\nimport time\nfrom pathlib import Path\n\nfrom flask import Flask, Response, jsonify, render_template_string\n\napp = Flask(__name__)\nLOG_FILE = Path(__file__).resolve().parent / "app.logs"\n\nHTML_PAGE = """\n<!doctype html>\n<html lang=\\"en\\">\n<head>\n  <meta charset=\\"utf-8\\">\n  <meta name=\\"viewport\\" content=\\"width=device-width, initial-scale=1\\">\n  <title>AI Engineer Dashboard</title>\n  <style>\n    body { font-family: Arial, sans-serif; margin: 2rem; background: #0f172a; color: #e2e8f0; }\n    .card { background: #111827; padding: 1rem 1.25rem; border-radius: 12px; margin-bottom: 1rem; }\n    .log-shell { background: #020617; border: 1px solid #1e293b; border-radius: 10px; padding: 0.75rem; max-height: 520px; overflow: auto; }\n    .log-entry { display: grid; grid-template-columns: 180px 1fr; gap: 0.75rem; padding: 0.45rem 0; border-bottom: 1px solid rgba(148, 163, 184, 0.14); }\n    .log-entry:last-child { border-bottom: none; }\n    .timestamp { color: #38bdf8; font-size: 0.85rem; white-space: nowrap; }\n    .message { white-space: pre-wrap; word-break: break-word; }\n    .empty { color: #94a3b8; padding: 0.5rem 0; }\n    a { color: #38bdf8; }\n  </style>\n</head>\n<body>\n  <div class=\\"card\\">\n    <h1>AI Engineer Dashboard</h1>\n    <p>This page shows the agent status and the most recent log output from the app.</p>\n    <p><a href=\\"/logs\\">Open live logs</a></p>\n  </div>\n  <div class=\\"card\\">\n    <h2>Recent activity</h2>\n    <div id=\\"log\\" class=\\"log-shell\\"><div class=\\"empty\\">Loading logs...</div></div>\n  </div>\n  <script>\n    const logBox = document.getElementById(\'log\');\n\n    function escapeHtml(value) {\n      return String(value)\n        .replace(/&/g, \'&amp;\')\n        .replace(/</g, \'&lt;\')\n        .replace(/>/g, \'&gt;\')\n        .replace(/\\"/g, \'&quot;\');\n    }\n\n    function renderLogs(text) {\n      const lines = (text || \'\').split(/\\r?\\n/).filter(Boolean);\n      if (!lines.length) {\n        logBox.innerHTML = \'<div class=\\"empty\\">No logs yet.</div>\';\n        return;\n      }\n\n      const rows = lines.map((line) => {\n        const match = line.match(/^(\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}:\\d{2},\\d{3})\\s+(INFO|WARNING|ERROR|DEBUG)\\s+(.*)$/i);\n        if (match) {\n          return `<div class=\\"log-entry\\"><div class=\\"timestamp\\">${escapeHtml(match[1])}</div><div class=\\"message\\">${escapeHtml(match[2])} ${escapeHtml(match[3])}</div></div>`;\n        }\n        return `<div class=\\"log-entry\\"><div class=\\"timestamp\\">live</div><div class=\\"message\\">${escapeHtml(line)}</div></div>`;\n      });\n\n      logBox.innerHTML = rows.join(\'\');\n      logBox.scrollTop = logBox.scrollHeight;\n    }\n\n    async function refreshLogs() {\n      try {\n        const response = await fetch(\'/logs-data\');\n        const text = await response.text();\n        renderLogs(text);\n      } catch (error) {\n        logBox.innerHTML = \'<div class=\\"empty\\">Unable to load logs right now.</div>\';\n      }\n    }\n\n    const eventSource = new EventSource(\'/stream-logs\');\n    eventSource.onmessage = function(event) {\n      renderLogs(event.data);\n    };\n    eventSource.onerror = function() {\n      logBox.innerHTML = \'<div class=\\"empty\\">Streaming logs unavailable. Reload the page to retry.</div>\';\n    };\n\n    refreshLogs();\n  </script>\n</body>\n</html>\n"""\n\n\n@app.get("/")\ndef home():\n    return render_template_string(HTML_PAGE)\n\n\n@app.get("/health")\ndef health():\n    return jsonify({"status": "healthy"})\n\n\n@app.get("/logs")\ndef logs_page():\n    return render_template_string(HTML_PAGE)\n\n\n@app.get("/logs-data")\ndef logs_data():\n    if not LOG_FILE.exists():\n        return Response("No logs yet.\\n", mimetype="text/plain")\n\n    try:\n        lines = LOG_FILE.read_text(encoding="utf-8").splitlines()\n    except Exception:\n        return Response("Unable to read logs.\\n", mimetype="text/plain")\n\n    tail = lines[-80:]\n    return Response("\\n".join(tail) + "\\n", mimetype="text/plain")\n\n\n@app.get("/stream-logs")\ndef stream_logs():\n    def generate():\n        while True:\n            if LOG_FILE.exists():\n                try:\n                    lines = LOG_FILE.read_text(encoding="utf-8").splitlines()\n                    payload = "\\n".join(lines[-80:])\n                except Exception:\n                    payload = "Unable to read logs."\n                yield f"data: {payload.replace(chr(10), chr(10) + \'data: \')}\\n\\n"\n            time.sleep(2)\n\n    return Response(generate(), mimetype="text/event-stream")\n\n\nif __name__ == "__main__":\n    app.run(host="127.0.0.1", port=5000, debug=False, use_reloader=False)\n\nfrom flask import Flask\n\napp = Flask(__name__)\n\n@app.get("/")\ndef home():\n    return "Hello, Flask!"\n\nif __name__ == "__main__":\n    app.run(debug=True)\n'}]}
